# -----------------------------------------------------------------------------
# ZuruSasa Mobile App — Environment Variables Template
# Copy this file to .env and fill in environment-specific values.
# NEVER commit .env, keystores, or server secrets to version control.
# -----------------------------------------------------------------------------

# -- Mobile Client Variables (Bundled into Expo App via EXPO_PUBLIC_*) --------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
EXPO_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.example.com/0
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=your-persona-template-id
EXPO_PUBLIC_PERSONA_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Supabase Edge Function Secrets (Server-side ONLY — configure via Supabase CLI)
# NEVER prefix these with EXPO_PUBLIC_ or embed them in mobile client code:
#
#   npx supabase secrets set --remote \
#     PAYSTACK_SECRET_KEY=sk_... \
#     PAYSTACK_PUBLIC_KEY=pk_... \
#     PERSONA_API_KEY=persona_... \
#     PERSONA_WEBHOOK_SECRET=whsec_... \
#     PERSONA_TEMPLATE_ID=... \
#     CRON_SECRET=<64-hex-char-secret> \
#     RESEND_API_KEY=re_... \
#     EMAIL_FROM="ZuruSasa <noreply@yourdomain.com>" \
#     AFRICASTALKING_API_KEY=... \
#     AFRICASTALKING_USERNAME=... \
#     UPSTASH_REDIS_REST_URL=https://your-redis-host.example.com \
#     UPSTASH_REDIS_REST_TOKEN=... \
#     FABLE_API_KEY=... \
#     FABLE_MODEL=claude-fable-5-1
# -----------------------------------------------------------------------------
