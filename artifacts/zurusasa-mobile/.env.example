# -------------------------------------------------------------
# ZuruSasa Mobile App — Environment Variables Example
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# -- Supabase (Public — safe to include in mobile app bundle) -----------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# -- Supabase Edge Function Secrets (Server-side ONLY via Supabase CLI) --------
# Set these as Supabase secrets — NEVER in EXPO_PUBLIC_* or client-side code.
#
# supabase secrets set FABLE_API_KEY=your-fable-api-key
# supabase secrets set FABLE_MODEL=claude-fable-5-1
# supabase secrets set UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
# supabase secrets set UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
#
# For local development with Supabase CLI:
# Add these to your local .env (next to this file):
FABLE_API_KEY=your-fable-api-key-here
FABLE_MODEL=claude-fable-5-1
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -- Optional: Paystack (Payments) ---------------------------------------------
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# -- Optional: Google Maps ------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# DEPLOYMENT NOTES
# -----------------------------------------------------------------------------
# 1. To set Supabase Edge Function secrets in production:
#    supabase secrets set FABLE_API_KEY=<value> --project-ref <your-ref>
#    supabase secrets set FABLE_MODEL=claude-fable-5-1 --project-ref <your-ref>
#    supabase secrets set UPSTASH_REDIS_REST_URL=<value> --project-ref <your-ref>
#    supabase secrets set UPSTASH_REDIS_REST_TOKEN=<value> --project-ref <your-ref>
#
# 2. Deploy the zuru-ai edge function:
#    supabase functions deploy zuru-ai --project-ref <your-ref>
#
# 3. The zuru-ai Edge Function reads FABLE_API_KEY server-side only (Deno.env).
#    It is never exposed to the React Native app bundle or client code.
